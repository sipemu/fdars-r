^\.github$
^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^README\.Rmd$
^cran-comments\.md$
^src/.*\.o$
^src/.*\.so$
^src/.*\.a$
^src/libfdars\.a$
^src/rust/target
^docs$
^_pkgdown\.yml$
^pkgdown$
^\.Rcheck$
^\.\./\.Rcheck$
^.*\.Rcheck$
^scripts$
^examples$
^CHANGELOG\.md$
^Rplots\.pdf$
^.*\.tar\.gz$
^vignettes$
^index\.md$
^validation$
# Exclude pkgdown-only SVGs (gallery cards and article diagrams)
^man/figures/card-.*\.svg$
^man/figures/.*-diagram\.svg$
^man/figures/diag-.*\.svg$
^man/figures/explainability-.*\.svg$
^man/figures/uq-.*\.svg$
^man/figures/sonar-.*\.svg$
# Exclude windows-sys paths that are too long (>100 bytes)
^src/rust/vendor/windows-sys.*/src/Windows/Win32/Management/MobileDeviceManagementRegistration
^src/rust/vendor/windows-sys.*/src/Windows/Win32/NetworkManagement/InternetConnectionWizard
^src/rust/vendor/windows-sys.*/src/Windows/Win32/NetworkManagement/NetworkDiagnosticsFramework
^src/rust/vendor/windows-sys.*/src/Windows/Win32/NetworkManagement/WindowsConnectionManager
^src/rust/vendor/windows-sys.*/src/Windows/Win32/NetworkManagement/WindowsFilteringPlatform
^src/rust/vendor/windows-sys.*/src/Windows/Win32/NetworkManagement/WindowsNetworkVirtualization
^src/rust/vendor/windows-sys.*/src/Windows/Win32/System/ApplicationInstallationAndServicing
^src/rust/vendor/windows-sys.*/src/Windows/Win32/System/Performance/HardwareCounterProfiling
# Exclude zerocopy test paths that are too long (>100 bytes)
^src/rust/vendor/zerocopy-derive/tests/ui-nightly/union_into_bytes_cfg
^src/rust/vendor/zerocopy-derive/tests/ui-stable/union_into_bytes_cfg
^src/rust/vendor/zerocopy/tests/ui-nightly/try_transmute_ref-dst-not-immutable
^src/rust/vendor/zerocopy/tests/ui-stable/try_transmute_ref-dst-not-immutable
